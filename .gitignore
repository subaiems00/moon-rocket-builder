# Godot 4+ specific ignores
.import/
.godot/
*.translation
*.gd.uid

# Imported binaries (can be regenerated by Godot on first run)
*.glb.import
*.gltf.import
*.png.import
*.svg.import
*.tres.import
*.tscn.import
*.gd.import

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Build output
build/
*.zip
*.exe

# Local save (do not commit user progress)
*.local
