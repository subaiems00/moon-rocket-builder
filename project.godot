; Moon Rocket Builder — Godot 4.x project file
; Hand-authored; you can also recreate via Project Settings → Project → Version.

config_version=5

[application]

config/name="Moon Rocket Builder"
config/description="Build a cartoon rocket, launch it, land on the Moon."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://autoload/GameManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
UIManager="*res://autoload/UIManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

